# Copy to .gitignore in a new photo site repository.
.DS_Store
__pycache__/
# Generated by scripts/site/build.py on every page load: every page, the
# thumbnails, and the routes. site/ holds no hand-written HTML.
site/**/*.html
site/thumbs/
site/routes.json
site/htaccess
site/**/*.tmp
# Brand fonts: never committed in a site repository. scripts/sync-fonts.sh
# copies them in from $FONTS_SRC (the standards repository by default).
site/assets/typefaces/
*.woff2
*.woff
*.ttf
*.otf
*.eot
# Deploy copy built by scripts/site/build-deploy.sh
work/
